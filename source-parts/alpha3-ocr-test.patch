+    /**
+     * Tests whether Whale OS lets this app read the HDMI picture rendered by TvView.
+     * The UI is hidden briefly so that OCR can only see the underlying HDMI frame.
+     * This is a diagnostic step; it does not yet start continuous subtitle translation.
+     */
+    private fun runOcrDiagnostic() {
+        if (ocrTesting) return
+        ocrTesting = true
+        Toast.makeText(this, "HDMI görüntüsü okunabilir mi diye test ediliyor…", Toast.LENGTH_SHORT).show()
+
+        val oldPanel = panel.visibility
+        val oldBadge = connectionBadge.visibility
+        val oldSubtitle = subtitle.visibility
+        val oldStatus = status.visibility
+        panel.visibility = View.GONE
+        connectionBadge.visibility = View.GONE
+        subtitle.visibility = View.GONE
+        status.visibility = View.GONE
+
+        main.postDelayed({
+            try {
+                val decor = window.decorView
+                val width = decor.width
+                val height = decor.height
+                if (width <= 0 || height <= 0) {
+                    restoreAfterOcrTest(oldPanel, oldBadge, oldSubtitle, oldStatus)
+                    showOcrDiagnostic("Görüntü alınamadı", "TV ekranının ölçüleri okunamadı. Uygulamayı yeniden açıp tekrar dene.")
+                    return@postDelayed
+                }
+
+                val frame = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+                PixelCopy.request(window, frame, { copyResult ->
+                    restoreAfterOcrTest(oldPanel, oldBadge, oldSubtitle, oldStatus)
+                    if (copyResult != PixelCopy.SUCCESS) {
+                        frame.recycle()
+                        val reason = when (copyResult) {
+                            PixelCopy.ERROR_SOURCE_NO_DATA -> "HDMI yüzeyinden henüz görüntü karesi gelmedi."
+                            PixelCopy.ERROR_SOURCE_INVALID -> "TV görüntü yüzeyi bu uygulamadan okunamıyor."
+                            PixelCopy.ERROR_TIMEOUT -> "Görüntü kopyalama zaman aşımına uğradı."
+                            PixelCopy.ERROR_DESTINATION_INVALID -> "Görüntü belleği oluşturulamadı."
+                            else -> "PixelCopy hata kodu: $copyResult"
+                        }
+                        showOcrDiagnostic("HDMI karesi okunamadı", "$reason\n\nBu durumda TV'nin HDMI görüntüsünü OCR'a açmasına izin vermesi için farklı bir görüntü yakalama yöntemi gerekir.")
+                    } else {
+                        val contrast = estimateFrameContrast(frame)
+                        val recognizer = textRecognizer ?: TextRecognition.getClient(TextRecognizerOptions.DEFAULT_OPTIONS).also {
+                            textRecognizer = it
+                        }
+                        try {
+                            recognizer.process(InputImage.fromBitmap(frame, 0))
+                                .addOnSuccessListener { visionText ->
+                                    val extracted = visionText.text.trim()
+                                    frame.recycle()
+                                    when {
+                                        contrast < 3.0 -> showOcrDiagnostic(
+                                            "HDMI görüntüsü engelleniyor olabilir",
+                                            "Ekran karesi kopyalandı ancak görüntü neredeyse siyah/tek renk (kontrast: \${"%.1f".format(contrast)}). TvView içindeki HDMI videosu ekran yakalamaya kapalı olabilir.\n\nBu test henüz oyun altyazısına erişebildiğimizi göstermiyor."
+                                        )
+                                        extracted.isBlank() -> showOcrDiagnostic(
+                                            "Görüntü alındı, yazı bulunamadı",
+                                            "TV görüntüsünden bir kare okunabildi (kontrast: \${"%.1f".format(contrast)}), fakat OCR yazı bulamadı. Testi tekrarlarken oyunun İngilizce altyazısı ekranda açıkça görünsün."
+                                        )
+                                        else -> showOcrDiagnostic(
+                                            "Görüntü ve OCR çalışıyor",
+                                            "HDMI karesinden okunan metin:\n\n\${extracted.take(900)}\n\nGörüntü kontrastı: \${"%.1f".format(contrast)}\n\nBu, OCR erişiminin çalıştığını gösterir. Sürekli altyazı takibi ve Türkçe çeviri sonraki adımdır."
+                                        )
+                                    }
+                                }
+                                .addOnFailureListener { error ->
+                                    frame.recycle()
+                                    showOcrDiagnostic("OCR hatası", "Görüntü karesi alındı fakat yazı tanıma başarısız oldu: \${error.localizedMessage ?: error.javaClass.simpleName}")
+                                }
+                        } catch (error: Exception) {
+                            frame.recycle()
+                            showOcrDiagnostic("OCR başlatılamadı", error.localizedMessage ?: error.javaClass.simpleName)
