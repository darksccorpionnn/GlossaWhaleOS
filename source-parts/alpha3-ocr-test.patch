+    private fun estimateFrameContrast(bitmap: Bitmap): Double {
+        val values = ArrayList<Double>(240)
+        val stepX = (bitmap.width / 24).coerceAtLeast(1)
+        val stepY = (bitmap.height / 10).coerceAtLeast(1)
+        var y = stepY / 2
+        while (y < bitmap.height) {
+            var x = stepX / 2
+            while (x < bitmap.width) {
+                val pixel = bitmap.getPixel(x, y)
+                val r = Color.red(pixel).toDouble()
+                val g = Color.green(pixel).toDouble()
+                val b = Color.blue(pixel).toDouble()
+                values.add(0.2126 * r + 0.7152 * g + 0.0722 * b)
+                x += stepX
+            }
+            y += stepY
+        }
+        if (values.isEmpty()) return 0.0
+        val mean = values.average()
+        val variance = values.sumOf { (it - mean) * (it - mean) } / values.size
+        return kotlin.math.sqrt(variance)
+    }
+
